# Public client configuration. Copy values from your own Supabase project.
# Do not put service_role / sb_secret keys here or in the desktop client.
TEBB_CLOUD_URL=https://YOUR_PROJECT_REF.supabase.co
TEBB_CLOUD_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# A test user's short-lived access token may be supplied in the process environment
# for the explicit read-only --connect check. Never commit or paste it in chat.
